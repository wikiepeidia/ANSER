# ── Shared auth (MUST match Gateway's .env exactly) ──────────────────────
# This app never verifies passwords — users sign in on Gateway (port 5000).
# It only decodes the shared session cookie and reads the same `users`
# table, so SECRET_KEY and the DB connection below must be identical to
# Gateway's own .env.
SECRET_KEY=copy-the-same-value-from-ANSER_gateway/.env
POSTGRES_URL=
DATABASE_PATH=group_project_ai_ml.db

# ── San Xuat's own business data (fully separate from Gateway/Retail) ───
# Leave SANXUAT_POSTGRES_URL empty to use local SQLite. Set it to switch to
# San Xuat's own Neon database — must be a DIFFERENT database than the
# shared POSTGRES_URL above, never the same one.
SANXUAT_DATABASE_PATH=san_xuat.db
SANXUAT_POSTGRES_URL=

# ── Misc ──────────────────────────────────────────────────────────────
PORT=5003
GATEWAY_ORIGIN=http://127.0.0.1:5000

# ── n8n riêng cho Sản xuất — chạy: docker compose up -d (port khác n8n ANSER) ──
N8N_ORIGIN=http://127.0.0.1:8681
