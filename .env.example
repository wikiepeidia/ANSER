# ── The real `users` DB — Gateway owns this for real (read+write) ───────
# Retail (:5002) and Sản xuất (:5003) only ever read it, using this same
# SECRET_KEY to trust the session cookie this app issues.
SECRET_KEY=copy-the-same-value-into-Retail-and-SanXuat-.env
POSTGRES_URL=
DATABASE_PATH=group_project_ai_ml.db

# ── Where each mảng lives ────────────────────────────────────────────────
PORT=5000
RETAIL_ORIGIN=http://127.0.0.1:5002
SANXUAT_ORIGIN=http://127.0.0.1:5003
