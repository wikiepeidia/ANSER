# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql://user:password@host/dbname?sslmode=require
REDIS_URL=redis://localhost:6379/0

# ── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret-here

# ── HuggingFace / AI Agent ─────────────────────────────────────────────────────
HF_BASE_URL=https://your-ngrok-or-hf-url.ngrok-free.dev
HF_TOKEN=hf_your_token_here

# ── Flask ──────────────────────────────────────────────────────────────────────
# Set 'development' khi chạy local (cho phép OAuth qua HTTP)
# Bỏ dòng này hoặc đặt 'production' khi deploy
FLASK_ENV=development
SECRET_KEY=generate-a-random-secret-key

# ── Google Analytics ──────────────────────────────────────────────────────────
GA_PROPERTY_ID=your-ga-property-id

# ── Files still required in secrets/ ─────────────────────────────────────────
# These two files cannot be flattened into env vars — place them manually:
#   secrets/analytics_service_account.json   (Google service account JSON)
#   secrets/token adminmail.json             (Gmail OAuth token — regenerate via secrets/generate token for welcome mail.py)
