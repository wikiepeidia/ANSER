# ── ANSER automation — .env.example (KHÔNG chứa secret thật; copy sang .env) ──

# ── n8n ──────────────────────────────────────────────────────────────────────
N8N_PORT=5678
N8N_EMBED_PORT=5679
# Mặc định loopback (an toàn). Thiết bị LAN (POS/IoT gateway) cần webhook -> 0.0.0.0
# (và BẮT BUỘC đặt ANSER_WEBHOOK_TOKEN bên dưới).
N8N_BIND=127.0.0.1

# n8n >= 1.0 dùng User Management: owner tạo lần đầu mở http://localhost:5678
# Cho scripts/import_workflows.py + tests/smoke/setup.py:
N8N_API_KEY=
N8N_EMAIL=
N8N_PASSWORD=

# Khóa mã hóa credentials — đặt 1 lần rồi GIỮ NGUYÊN. Sinh: openssl rand -hex 24
N8N_ENCRYPTION_KEY=

# URL công khai cho webhook (khi expose qua domain/tunnel; local để trống dùng default)
# WEBHOOK_URL=https://your-domain.example.com/

# ── Bảo mật webhook (SEC-3) ──────────────────────────────────────────────────
# Client phải gửi header x-anser-token khớp giá trị này. Trống = TẮT (chỉ demo local).
# Sinh: openssl rand -hex 16
ANSER_WEBHOOK_TOKEN=

# ── Discord (SEC-1: workflow đọc qua $env, không hardcode) ───────────────────
# Dev: trỏ discord-mock. Prod: dán Discord webhook URL thật.
DISCORD_WEBHOOK_URL=http://discord-mock:9099/discord-webhook

# ── Brain / rag (service name trong docker network) ──────────────────────────
BRAIN_BASE_URL=http://mock-brain:8100
RAG_BASE_URL=http://rag_service:8001

# ── Notifier đa kênh + stub tích hợp ngoài ──────────────────────────────────
# Dev: mọi kênh trỏ discord-mock (phân biệt qua path). Prod: đổi sang API thật.
NOTIFY_URL=http://localhost:5678/webhook/notify
TELEGRAM_WEBHOOK_URL=http://discord-mock:9099/telegram
ZALO_WEBHOOK_URL=http://discord-mock:9099/zalo
FB_POST_URL=http://discord-mock:9099/facebook     # QT7 (đăng bài — sau khi người duyệt)
RESEARCHER_URL=http://discord-mock:9099/researcher # QT10 (ResearcherAgent — hiện stub trong workflow)
DOCS_URL=http://discord-mock:9099/google-docs      # manuf QT7 (xuất Google Docs — prod: Body /api/google/docs-create)

# ── Postgres test (trong compose) ────────────────────────────────────────────
ANSER_PG_DB=anser_test
ANSER_PG_USER=postgres
ANSER_PG_PASSWORD=change_me_local
ANSER_PG_PORT=15432
CHROMA_PORT=8000

# rag_service tự build POSTGRES_URL từ ANSER_PG_* (để trống = dùng compose default).
# Prod: đặt POSTGRES_URL trỏ NeonDB.
POSTGRES_URL=

# ── C1: Thanh toán QR (SePay + VietQR) ──
VIETQR_BANK=            # mã ngân hàng ngắn: MB/VCB/TCB...
VIETQR_ACC=             # số TK nhận tiền
VIETQR_NAME=            # tên chủ TK in trên QR
SEPAY_API_KEY=          # SePay dashboard -> Webhooks -> Kiểu chứng thực API Key
# ── B1: HĐĐT — NCC thật (MISA/VNPT/Viettel) điền URL khi có hợp đồng; dev dùng mock ──
EINVOICE_API_URL=       # bỏ trống = mock (http://einvoice-mock:8200)
