# Normalize line endings for all text files to LF in the repo,
# checked out as LF on Windows/Mac/Linux alike (avoids CRLF/LF diff churn).
* text=auto eol=lf

# Windows-only scripts must keep CRLF to run correctly.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files — never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.xlsx binary
*.pyc binary
