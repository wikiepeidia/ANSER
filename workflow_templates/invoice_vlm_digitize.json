    "Có lỗi kết nối Brain?": {
      "main": [
        [{ "node": "Tạo thông báo Discord", "type": "main", "index": 0 }],
        [{ "node": "Cần xem lại thủ công?", "type": "main", "index": 0 }]
      ]
    },
    "Cần xem lại thủ công?": {
      "main": [
        [{ "node": "Tạo thông báo Discord", "type": "main", "index": 0 }],
        [{ "node": "Ghi phiếu chờ duyệt vào Body", "type": "main", "index": 0 }]
      ]
    },
    "Tạo thông báo Discord": { "main": [[{ "node": "Gửi Discord", "type": "main", "index": 0 }]] },
