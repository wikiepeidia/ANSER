{
  "name": "Khách hàng mới → Welcome",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "new-customer",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "nc-webhook",
      "name": "Nhận khách mới",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [180, 300]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst body = (raw.body && typeof raw.body === 'object') ? raw.body : raw;\nif (!body.name) {\n  return [{ json: { valid: false, error: 'Thiếu tên khách hàng (name)' } }];\n}\nreturn [{ json: {\n  valid: true,\n  name:    String(body.name),\n  email:   body.email || null,\n  phone:   body.phone || null,\n  address: body.address || null,\n  request_body: JSON.stringify({ name: body.name, email: body.email || null, phone: body.phone || null, address: body.address || null })\n} }];"
      },
      "id": "nc-validate",
      "name": "Validate thông tin",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [{ "value1": "={{ $json.valid }}", "value2": true }]
        }
      },
      "id": "nc-if",
      "name": "Hợp lệ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [660, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://rag-service:8001/customer-insert",
        "authentication": "none",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.request_body }}",
        "options": {}
      },
      "id": "nc-insert",
      "name": "Lưu vào NeonDB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [900, 180]
    },
    {
      "parameters": {
        "jsCode": "const db = $input.first().json;\nconst orig = $('Validate thông tin').first().json;\nconst body = {\n  embeds: [{\n    title: '👋 Khách hàng mới!',\n    color: 3447003,\n    fields: [\n      { name: 'Tên', value: orig.name, inline: true },\n      { name: 'Mã KH', value: db.code || '—', inline: true },\n      { name: 'SĐT', value: orig.phone || 'Chưa có', inline: true },\n      { name: 'Email', value: orig.email || 'Chưa có', inline: true },\n      { name: 'Địa chỉ', value: orig.address || 'Chưa có', inline: false }\n    ],\n    footer: { text: 'ANSER CRM • NeonDB' },\n    timestamp: new Date().toISOString()\n  }]\n};\nconst resp = { status: 'ok', id: db.id, code: db.code, name: orig.name };\nreturn [{ json: { discord_body: JSON.stringify(body), response_201: JSON.stringify(resp) } }];"
      },
      "id": "nc-format",
      "name": "Tạo thông báo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1140, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://discord.com/api/webhooks/1515444369480745063/ZlYUlYstgHrc5-P7lZTrcZcsGVGrqo2rvxq_IAPPREB_YP4ci1EZVe0oVC7SZX1Da89R",
        "authentication": "none",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.discord_body }}",
        "options": {}
      },
      "id": "nc-discord",
      "name": "Gửi Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1380, 180]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $('Tạo thông báo').first().json.response_201 }}",
        "options": { "responseCode": 201 }
      },
      "id": "nc-respond-ok",
      "name": "Trả 201",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1620, 180]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: $json.error, status: 400 }) }}",
        "options": { "responseCode": 400 }
      },
      "id": "nc-respond-err",
      "name": "Trả 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 420]
    }
  ],
  "connections": {
