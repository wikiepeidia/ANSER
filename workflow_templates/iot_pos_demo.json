{
  "name": "Demo POS — IoT → NeonDB → Email",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "pos-event",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "pos-webhook-001",
      "name": "Nhận sự kiện POS",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [180, 300]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst body = (raw.body && typeof raw.body === 'object') ? raw.body : raw;\nconst missing = [];\nif (!body.device_id)  missing.push('device_id');\nif (!body.event_type) missing.push('event_type');\nif (missing.length > 0) {\n  return [{ json: { valid: false, error: `Thiếu trường bắt buộc: ${missing.join(', ')}` } }];\n}\nconst amount = body.payload?.amount || 0;\nconst d = {\n  valid: true,\n  device_id:  String(body.device_id),\n  event_type: String(body.event_type),\n  payload:    body.payload || {},\n  amount_vnd: amount,\n  amount_fmt: new Intl.NumberFormat('vi-VN').format(amount) + ' VND',\n  notify_email: body.notify_email || ''\n};\nd.request_body = JSON.stringify({ device_id: d.device_id, event_type: d.event_type, payload: d.payload });\nreturn [{ json: d }];"
      },
      "id": "pos-code-001",
      "name": "Kiểm tra và làm giàu dữ liệu",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [{ "value1": "={{ $json.valid }}", "value2": true }]
        }
      },
      "id": "pos-if-001",
      "name": "Hợp lệ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [620, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:5002/api/n8n/internal/iot-events",
        "authentication": "none",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.request_body }}",
        "options": {}
      },
      "id": "pos-httpreq-001",
      "name": "Gọi iot-insert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [840, 180]
    },
    {
      "parameters": {
        "jsCode": "const dbResult = $input.first().json;\nconst orig = $('Kiểm tra và làm giàu dữ liệu').first().json;\nconst d = { ...orig, db_id: dbResult.id, created_at: dbResult.created_at, db_ok: true };\nconst isInvoice = ['sale_completed', 'payment_received', 'invoice'].includes(d.event_type);\nd.email_subject = (isInvoice ? 'Hóa đơn mới' : 'Sự kiện POS') + ' — ' + d.device_id;\nd.email_html = `<h2>${d.email_subject}</h2><p>Thiết bị: <b>${d.device_id}</b></p><p>Loại: ${d.event_type}</p><p>DB Record: #${d.db_id || '?'}</p><p>Số tiền: ${d.amount_fmt || 'N/A'}</p><p>Thời gian: ${d.created_at || new Date().toISOString()}</p>`;\nd.response_201 = JSON.stringify({ status: 'ok', id: d.db_id, device: d.device_id, event: d.event_type, timestamp: d.created_at });\nreturn [{ json: d }];"
      },
      "id": "pos-code-002",
      "name": "Làm giàu & dựng nội dung email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1060, 180]
    },
    {
      "parameters": {
        "conditions": {
          "string": [{ "value1": "={{ $json.notify_email }}", "operation": "isNotEmpty" }]
        }
      },
      "id": "pos-if-email",
      "name": "Có email báo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1280, 180]
    },
    {
      "parameters": {
        "fromEmail": "alerts@anser.local",
        "toEmail": "={{ $json.notify_email }}",
        "subject": "={{ $json.email_subject }}",
        "html": "={{ $json.email_html }}",
        "options": {}
      },
      "id": "pos-httpreq-002",
      "name": "Gửi thông báo Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1500, 120]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $('Làm giàu & dựng nội dung email').first().json.response_201 }}",
        "options": { "responseCode": 201 }
      },
      "id": "pos-respond-201",
      "name": "Trả về 201",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1720, 180]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: $json.error, status: 400 }) }}",
        "options": { "responseCode": 400 }
      },
      "id": "pos-respond-400",
      "name": "Trả về 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [840, 420]
    }
  ],
  "connections": {
    "Nhận sự kiện POS":     { "main": [[{ "node": "Kiểm tra và làm giàu dữ liệu",       "type": "main", "index": 0 }]] },
    "Kiểm tra và làm giàu dữ liệu":     { "main": [[{ "node": "Hợp lệ?",                   "type": "main", "index": 0 }]] },
    "Hợp lệ?": {
      "main": [
        [{ "node": "Gọi iot-insert", "type": "main", "index": 0 }],
        [{ "node": "Trả về 400",     "type": "main", "index": 0 }]
      ]
    },
    "Gọi iot-insert":       { "main": [[{ "node": "Làm giàu & dựng nội dung email",  "type": "main", "index": 0 }]] },
    "Làm giàu & dựng nội dung email":{ "main": [[{ "node": "Có email báo?",          "type": "main", "index": 0 }]] },
    "Có email báo?": {
      "main": [
        [{ "node": "Gửi thông báo Email", "type": "main", "index": 0 }],
        [{ "node": "Trả về 201",          "type": "main", "index": 0 }]
      ]
    },
    "Gửi thông báo Email":        { "main": [[{ "node": "Trả về 201",             "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
