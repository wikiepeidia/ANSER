{
  "name": "manuf_ocr_customer_order",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "customer-order-ocr", "responseMode": "responseNode", "options": { "binaryData": true } },
      "id": "co-webhook",
      "name": "Receive Order Upload",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [180, 300]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst expected = $env.ANSER_WEBHOOK_TOKEN || '';\nif (expected && ((raw.headers || {})['x-anser-token'] || '') !== expected) {\n  return [{ json: { valid: false, error: 'Unauthorized' } }];\n}\nif (!raw.binary || Object.keys(raw.binary).length === 0) {\n  return [{ json: { valid: false, error: 'Thiếu tệp ảnh đơn hàng để OCR' } }];\n}\nconst b = (raw.body && typeof raw.body === 'object') ? raw.body : raw;\n// scenario is now vestigial mock-testing-only metadata -- not consumed by the real OCR call.\nreturn [{ json: { valid: true, scenario: b.scenario || 'order', order_code_override: b.order_code || null } }];"
      },
      "id": "co-verify",
      "name": "Verify Anser Token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 300]
    },
    {
      "parameters": { "conditions": { "boolean": [{ "value1": "={{ $json.valid }}", "value2": true }] } },
