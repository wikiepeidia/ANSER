        "body": "={{ JSON.stringify({ kind: 'customer_order', reason: 'Lech tong ' + $json.validation.difference + ' VND', ocr_total: $json.validation.stated_total, calculated_total: $json.validation.calculated_total, raw_payload: $('Call Brain OCR Order').first().json }) }}",
        "options": {}
      },
