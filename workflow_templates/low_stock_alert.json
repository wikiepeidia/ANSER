{
  "name": "Cảnh báo tồn kho thấp",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 6 }] }
      },
      "id": "ls-trigger",
      "name": "Mỗi 6 giờ",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [180, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://rag-service:8001/low-stock?threshold=10",
        "authentication": "none",
        "options": {}
      },
      "id": "ls-fetch",
      "name": "Kiểm tra tồn kho",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [420, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [{ "value1": "={{ $json.count }}", "operation": "larger", "value2": 0 }]
        }
      },
      "id": "ls-if",
      "name": "Có SP cần nhập?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [660, 300]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst items = data.items || [];\nconst list = items.map(p => `⚠️ **${p.name}** (${p.code}) — còn **${p.stock_quantity}** | giá ${new Intl.NumberFormat('vi-VN').format(p.price)} đ`).join('\\n');\nconst body = {\n  embeds: [{\n    title: '🚨 Cảnh báo tồn kho thấp',\n    color: 16744448,\n    description: `Có **${items.length}** sản phẩm dưới ngưỡng ${data.threshold}:\\n\\n${list}`,\n    footer: { text: 'ANSER Stock Alert • NeonDB' },\n    timestamp: new Date().toISOString()\n  }]\n};\nreturn [{ json: { discord_body: JSON.stringify(body) } }];"
      },
      "id": "ls-format",
      "name": "Tạo cảnh báo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://discord.com/api/webhooks/1515444369480745063/ZlYUlYstgHrc5-P7lZTrcZcsGVGrqo2rvxq_IAPPREB_YP4ci1EZVe0oVC7SZX1Da89R",
        "authentication": "none",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.discord_body }}",
        "options": {}
      },
      "id": "ls-discord",
      "name": "Gửi Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1140, 180]
    }
  ],
  "connections": {
    "Mỗi 6 giờ":       { "main": [[{ "node": "Kiểm tra tồn kho", "type": "main", "index": 0 }]] },
    "Kiểm tra tồn kho": { "main": [[{ "node": "Có SP cần nhập?",  "type": "main", "index": 0 }]] },
    "Có SP cần nhập?": {
      "main": [
        [{ "node": "Tạo cảnh báo", "type": "main", "index": 0 }],
        []
      ]
    },
    "Tạo cảnh báo":    { "main": [[{ "node": "Gửi Discord",       "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
