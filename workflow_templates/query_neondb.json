        "queryParameters": {
          "parameters": [
            { "name": "limit", "value": "={{ $json.body?.limit || 5 }}" }
          ]
        },
        "options": {}
      },
      "id": "qdb-fetch",
      "name": "Lấy IoT Events từ NeonDB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst events = response.events || [];\nconst total = response.total || 0;\n\nreturn [{\n  json: {\n    success: true,\n    source: 'NeonDB via ANSER API',\n    total_events: total,\n    showing: events.length,\n    events: events.map(e => ({\n      id: e.id,\n      device: e.device_id,\n      type: e.event_type,\n      amount: e.payload?.amount || null,\n      time: e.created_at\n    })),\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "qdb-format",
      "name": "Format kết quả",
